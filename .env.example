# Copy to .env and fill in. Empty values fall back to dev defaults in docker-compose.yml.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host ports (defaults 5440/8010/5180). Change them, plus COMPOSE_PROJECT_NAME,
# to run a second stack next to the first one (e.g. from a git worktree).
# COMPOSE_PROJECT_NAME=recipe-macros-2
DB_HOST_PORT=
BACKEND_HOST_PORT=
FRONTEND_HOST_PORT=

# Anthropic API key (used from Step 4 on, backend only)
ANTHROPIC_API_KEY=
# Model used for AI import (default: claude-haiku-5-5)
AI_MODEL=

# Password of the restricted app_user role the API connects as (URL-safe characters only)
APP_DB_PASSWORD=

# Auth: secret for signing JWTs (required when COOKIE_SECURE=true; generate: openssl rand -hex 32),
# allowed CORS origins
JWT_SECRET=
# Empty = http://localhost:<FRONTEND_HOST_PORT>. If set, it no longer follows FRONTEND_HOST_PORT.
CORS_ORIGINS=
COOKIE_SECURE=
